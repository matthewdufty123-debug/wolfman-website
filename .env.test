# Environment for the E2E harness (`npm run test:e2e`).
# Every value here is fake and local-only — this file is safe to commit and is
# never used by dev or production, which read .env.local and Vercel respectively.

DATABASE_URL=postgresql://wolfman@localhost:55432/wolfman_test
DATABASE_DRIVER=pg

AUTH_SECRET=e2e-harness-secret-not-used-anywhere-real
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3100

# OAuth providers are constructed at import time, so they need values present.
# No OAuth flow is exercised by the E2E tests.
GITHUB_CLIENT_ID=e2e-unused
GITHUB_CLIENT_SECRET=e2e-unused
GOOGLE_CLIENT_ID=e2e-unused
GOOGLE_CLIENT_SECRET=e2e-unused

# Third-party services are never called in tests; these keep module init happy.
ANTHROPIC_API_KEY=e2e-unused
RESEND_API_KEY=e2e-unused
STRIPE_SECRET_KEY=e2e-unused
BLOB_READ_WRITE_TOKEN=e2e-unused
